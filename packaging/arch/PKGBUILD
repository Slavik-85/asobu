# Asobu as an Arch package, built by the release workflow from the release's own Linux tarball,
# so it is the same build every other platform gets, CurseForge key included. Installs exactly
# what the .deb and .rpm do: the app under /opt/asobu, /usr/bin/asobu, a menu entry, AppStream
# metadata and icons. @VERSION@ is filled in by the workflow.

pkgname=asobu
pkgver=@VERSION@
pkgrel=1
pkgdesc="Minecraft: Java Edition launcher"
arch=('x86_64')
url="https://asobu.cc"
license=('GPL-3.0-only')
depends=('fontconfig' 'libx11' 'libice' 'libsm' 'icu' 'openssl' 'xdg-utils' 'ca-certificates')
optdepends=('xorg-xrandr: Minecraft 1.12 and older'
            'libsecret: keeping a Microsoft sign-in in the desktop keyring')
# .NET's own binaries, which stripping breaks.
options=('!strip' '!debug')
source=("Asobu-linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
  install -d "$pkgdir/opt" "$pkgdir/usr/bin" "$pkgdir/usr/share"
  cp -a "$srcdir/asobu" "$pkgdir/opt/asobu"

  # The tarball's own installer is for installing without a package manager, and the marker
  # tells the app that pacman owns these files now.
  rm -f "$pkgdir/opt/asobu/install.sh"
  echo arch > "$pkgdir/opt/asobu/package-type"

  ln -s /opt/asobu/Asobu.App "$pkgdir/usr/bin/asobu"
  install -Dm644 "$srcdir/asobu/cc.asobu.Asobu.desktop" "$pkgdir/usr/share/applications/cc.asobu.Asobu.desktop"
  install -Dm644 "$srcdir/asobu/cc.asobu.Asobu.metainfo.xml" "$pkgdir/usr/share/metainfo/cc.asobu.Asobu.metainfo.xml"
  cp -r "$srcdir/asobu/icons" "$pkgdir/usr/share/icons"
}

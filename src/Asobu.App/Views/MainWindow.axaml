<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Asobu.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="Asobu.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Asobu"
        Width="1120" Height="740" MinWidth="960" MinHeight="640"
        Background="{DynamicResource Bg}">

  <Grid ColumnDefinitions="232,*">

    <Border Grid.Column="0" Background="{DynamicResource SurfaceAlt}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="11" Margin="6,8,0,26">
          <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Accent}">
            <Path Data="M 0,0 L 9,5.5 L 0,11 Z" Fill="{DynamicResource OnAccent}" Width="9" Height="11"
                  Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="asobu" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Classes="accountBar" Margin="0,16,0,0">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="0" Classes="accountChip" Classes.active="{Binding IsAccounts}"
                    Command="{Binding GoAccountsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="11">
                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentSoft}">
                  <TextBlock Text="&#x1F338;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding AccountLabel}" FontSize="13" FontWeight="Medium"/>
                  <TextBlock Text="{Binding AccountKindLabel}" Classes="label"/>
                </StackPanel>
              </StackPanel>
            </Button>
            <Border Grid.Column="1" Width="1" Margin="2,8" Background="{DynamicResource Border}"/>
            <Button Grid.Column="2" Classes="gearButton" Classes.active="{Binding IsSettings}"
                    Command="{Binding GoSettingsCommand}"
                    ToolTip.Tip="Settings">
              <Path Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm8.94 3a7.97 7.97 0 0 0-.6-2.3l1.68-1.46-2-3.46-2.1.72a8.05 8.05 0 0 0-1.99-1.15L15.5 1h-4l-.43 2.35a8.05 8.05 0 0 0-1.99 1.15l-2.1-.72-2 3.46L6.66 8.7A7.97 7.97 0 0 0 6.06 11H3.5v4h2.56c.1.81.31 1.58.6 2.3l-1.68 1.46 2 3.46 2.1-.72c.61.47 1.28.86 1.99 1.15L11.5 23h4l.43-2.35a8.05 8.05 0 0 0 1.99-1.15l2.1.72 2-3.46-1.68-1.46c.29-.72.5-1.49.6-2.3H23v-4h-2.06Z"
                    Fill="{DynamicResource TextMuted}" Stretch="Uniform" Width="15" Height="15"/>
            </Button>
          </Grid>
        </Border>

        <StackPanel Spacing="3" VerticalAlignment="Top">
          <Button Classes="nav" Classes.active="{Binding IsInstancesArea}"
                  Command="{Binding GoInstancesCommand}" Content="Instances"/>
        </StackPanel>

      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>

  </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:Asobu.App.Controls"
             xmlns:vm="using:Asobu.App.ViewModels"
             x:Class="Asobu.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer ctrl:SmoothScroll.Enabled="True">
    <StackPanel Margin="30,28,30,28" MaxWidth="720" HorizontalAlignment="Left" Spacing="18">

      <StackPanel>
        <TextBlock Text="Settings" Classes="h1"/>
        <TextBlock Classes="sub" Margin="0,5,0,0" Text="Changes save as you make them."/>
      </StackPanel>

      <!-- Appearance. Applies as it's picked, so the page itself is the preview. -->
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="Appearance" Classes="h2"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="Light or dark, and the colour of the place."/>
          </StackPanel>

          <WrapPanel>
            <RadioButton Classes="chip" GroupName="mode" Margin="0,0,8,0" Content="Match system" IsChecked="{Binding ModeSystem}"/>
            <RadioButton Classes="chip" GroupName="mode" Margin="0,0,8,0" Content="Light" IsChecked="{Binding ModeLight}"/>
            <RadioButton Classes="chip" GroupName="mode" Content="Dark" IsChecked="{Binding ModeDark}"/>
          </WrapPanel>

          <ItemsControl ItemsSource="{Binding Themes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeChoice">
                <RadioButton Classes="chip" GroupName="theme" Margin="0,0,8,8" IsChecked="{Binding IsSelected}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="12" Height="12" Fill="{Binding Swatch}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Two sliders are the whole of a custom theme: where the accent sits on the wheel,
               and how much of it the greys pick up. -->
          <Grid ColumnDefinitions="110,*,90" RowDefinitions="Auto,Auto" RowSpacing="10"
                IsVisible="{Binding IsCustomTheme}">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Colour" Classes="label" VerticalAlignment="Center"/>
            <Panel Grid.Row="0" Grid.Column="1">
              <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#C74343" Offset="0"/>
                    <GradientStop Color="#C7C743" Offset="0.1667"/>
                    <GradientStop Color="#43C743" Offset="0.3333"/>
                    <GradientStop Color="#43C7C7" Offset="0.5"/>
                    <GradientStop Color="#4343C7" Offset="0.6667"/>
                    <GradientStop Color="#C743C7" Offset="0.8333"/>
                    <GradientStop Color="#C74343" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Slider Minimum="0" Maximum="360" Value="{Binding ThemeHue}"/>
            </Panel>
            <Ellipse Grid.Row="0" Grid.Column="2" Width="18" Height="18" HorizontalAlignment="Right"
                     Fill="{DynamicResource Accent}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Background tint" Classes="label" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding ThemeTint}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ThemeTintLabel}" Classes="value"
                       TextAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Memory -->
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="Memory" Classes="h2"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="How much RAM Minecraft may use. More is not better — an oversized heap trades frequent short pauses for rare long ones, which is the stutter people blame on their PC."/>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Size it per instance" Classes="value"/>
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="Vanilla gets 2 GB, a big pack gets more, always capped by what this machine can spare."/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutomaticMemory}"
                          OnContent="" OffContent="" VerticalAlignment="Center"/>
          </Grid>

          <Grid ColumnDefinitions="110,*,90" RowDefinitions="Auto,Auto" RowSpacing="10"
                IsEnabled="{Binding !AutomaticMemory}">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Maximum" Classes="label" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" Minimum="512" Maximum="{Binding MaximumMemoryMb}"
                    TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MaxMemoryMb}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MaxMemoryLabel}" Classes="value"
                       TextAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum" Classes="label" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="512" Maximum="{Binding MaximumMemoryMb}"
                    TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MinMemoryMb}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MinMemoryLabel}" Classes="value"
                       TextAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Graphics. Windows only; see SettingsViewModel.ShowGraphics. -->
      <Border Classes="card" Padding="24" IsVisible="{Binding ShowGraphics}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Graphics" Classes="h2"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="Which GPU Windows gives the game. On laptops Java often lands on the integrated chip unless told otherwise."/>
          </StackPanel>

          <ComboBox ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding Gpu}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GpuOption">
                <StackPanel Margin="0,3">
                  <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="Medium"/>
                  <TextBlock Text="{Binding Detail}" Classes="label"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{Binding DetectedGpus, StringFormat='Detected: {0}'}" Classes="label"/>
        </StackPanel>
      </Border>

      <!-- Java -->
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Java" Classes="h2"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="Leave this on automatic unless you know you need a specific runtime. Asobu installs the exact one each version wants."/>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox Grid.Column="0" ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding Java}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JavaOption">
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="Medium"/>
                    <TextBlock Text="{Binding Detail}" Classes="label"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Classes="ghost" Content="Rescan"
                    Command="{Binding RefreshJavaOptionsCommand}"/>
          </Grid>

          <StackPanel Spacing="6" Margin="0,4,0,0">
            <TextBlock Text="Extra JVM arguments" Classes="label"/>
            <TextBox Text="{Binding ExtraJvmArguments}" PlaceholderText="-XX:+UseG1GC"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Letting friends in, and what it costs.

           On is what Asobu has always done. The switch exists because making it work means every
           launch talks to Mojang through a stand-in of Asobu's own, which no other launcher does
           - so when something about connecting is not working, this is the first thing to take
           out of the picture. -->
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Text="Friends" Classes="h2"/>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Let friends without a Microsoft account join" Classes="value"/>
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="Asobu vouches for invited guests, which means the game reaches Mojang through Asobu for the whole session. Turn it off to talk to Mojang directly - worth trying if joining servers or voice chat is unreliable. Guests can no longer be invited while it is off."/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LetOfflineFriendsJoin}"
                          OnContent="" OffContent="" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Files -->
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Files" Classes="h2"/>
            <TextBlock Text="{Binding DataFolder}" Classes="label" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Content="Open Asobu folder" Command="{Binding OpenDataFolderCommand}"/>
            <Button Classes="ghost" Content="Instances" Command="{Binding OpenInstancesFolderCommand}"/>
            <Button Classes="ghost" Content="Logs" Command="{Binding OpenLogsFolderCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Microsoft. Hidden unless a client id has been set: see ShowMicrosoftSetup. -->
      <Border Classes="card" Padding="24" IsVisible="{Binding ShowMicrosoftSetup}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Microsoft sign-in" Classes="h2"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="Mojang only lets approved applications sign people in to Minecraft. Until Asobu's own registration is approved, device code borrows the official launcher's."/>
          </StackPanel>

          <ComboBox ItemsSource="{Binding SignInOptions}" SelectedItem="{Binding SignIn}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SignInOption">
                <StackPanel Margin="0,3">
                  <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="Medium"/>
                  <TextBlock Text="{Binding Detail}" Classes="label" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Spacing="6" Margin="0,4,0,0">
            <TextBlock Text="Azure client id" Classes="label"/>
            <TextBox Text="{Binding MicrosoftClientId}" PlaceholderText="00000000-0000-0000-0000-000000000000"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Mod sources. Hidden in any build that carries its own key: see ShowCurseForgeKey. -->
      <Border Classes="card" Padding="24" IsVisible="{Binding ShowCurseForgeKey}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="CurseForge" Classes="h2"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="{Binding CurseForgeStatus}"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding CurseForgeApiKey}" PasswordChar="&#x2022;"
                     PlaceholderText="{Binding CurseForgeKeyPlaceholder}"/>
            <Button Grid.Column="1" Classes="ghost" Content="Get a key"
                    Command="{Binding GetCurseForgeKeyCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Updates. Absent in a build with no update path — running from a build folder
           rather than an install has nothing to update. A Linux package gets the card too, as
           a notice: its package manager does the updating. -->
      <Border Classes="card" Padding="24" IsVisible="{Binding Updates.ShowCard}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Updates" Classes="h2"/>
            <TextBlock Classes="sub" TextWrapping="Wrap" Text="{Binding Updates.Blurb}"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding Updates.StatusLine}" Classes="value"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Classes="primary" Content="Download"
                    IsVisible="{Binding Updates.IsAvailable}"
                    Command="{Binding Updates.DownloadCommand}"/>
            <Button Grid.Column="1" Classes="ghost" Content="Check now"
                    IsEnabled="{Binding !Updates.IsChecking}"
                    Command="{Binding Updates.CheckCommand}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!Updates.IsReady"/>
                  <Binding Path="!Updates.IsAvailable"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <Button Grid.Column="1" Classes="primary" Content="Restart now"
                    IsVisible="{Binding Updates.IsReady}"
                    IsEnabled="{Binding Updates.CanRestart}"
                    ToolTip.Tip="Close Minecraft first"
                    Command="{Binding Updates.RestartCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Getting started -->
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Getting started" Classes="h2"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="The welcome and the tour are both shown once, on a first launch. Play either again from here."/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Content="Replay the welcome" Command="{Binding ReplayIntroCommand}"/>
            <Button Classes="ghost" Content="Replay the tour" Command="{Binding ReplayTourCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

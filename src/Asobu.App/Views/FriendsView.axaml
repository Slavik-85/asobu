<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:Asobu.App.Controls"
             xmlns:vm="using:Asobu.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Asobu.App.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">

  <!-- The inside of the friends drawer. The header and close button belong to the drawer
       itself, over in MainWindow; this is everything under them. -->
  <Panel Margin="22,6,22,18">

    <!-- ============ No account at all ============ -->
    <StackPanel VerticalAlignment="Center" Spacing="10" IsVisible="{Binding NeedsAccount}">
      <TextBlock Text="&#x1F338;" FontSize="34" HorizontalAlignment="Center"/>
      <TextBlock Text="Friends needs an account" Classes="h2" HorizontalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{DynamicResource TextMuted}"/>
      <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap"
                 Text="Sign in with Microsoft and your Minecraft identity is your identity here — nothing else to make. An offline account works too, with a tag after the name."/>
      <Button Classes="primary" Content="Go to Accounts" HorizontalAlignment="Center" Margin="0,8,0,0"
              Command="{Binding GoAccountsCommand}"/>
    </StackPanel>

    <!-- ============ An offline account, not on the network yet ============ -->
    <!-- Asked rather than assumed. An offline name is a local thing until somebody says
         otherwise, and joining publishes it — so joining is a button, pressed once. -->
    <StackPanel VerticalAlignment="Center" Spacing="10" IsVisible="{Binding NeedsOfflineJoin}">
      <TextBlock Text="&#x1F338;" FontSize="34" HorizontalAlignment="Center"/>
      <TextBlock Text="Join the friends network" Classes="h2" HorizontalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{DynamicResource TextMuted}"/>
      <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap"
                 Text="Offline accounts can use friends and chat. Since nobody can vouch for an offline name, Asobu adds four random digits after it — like Player#4963 — and that pair is what friends type to find you."/>
      <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"
                 Foreground="{DynamicResource TextMuted}"
                 Text="Five offline accounts per computer and per connection."/>
      <Button Classes="primary" Content="Join the network" HorizontalAlignment="Center" Margin="0,8,0,0"
              IsEnabled="{Binding !IsConnecting}"
              Command="{Binding JoinNetworkCommand}"/>
      <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource Accent}"
                 IsVisible="{Binding ConnectionError, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                 Text="{Binding ConnectionError}"/>
    </StackPanel>

    <!-- ============ Connection trouble ============ -->
    <!-- ConnectionError is only ever set by a connection attempt and cleared on account change,
         so its presence alone decides this state. -->
    <StackPanel VerticalAlignment="Center" Spacing="10"
                IsVisible="{Binding ConnectionError, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <TextBlock Text="&#x1F327;" FontSize="34" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding ConnectionError}" Classes="sub" TextAlignment="Center" TextWrapping="Wrap"/>
      <Button Classes="ghost" Content="Try again" HorizontalAlignment="Center" Margin="0,8,0,0"
              Command="{Binding RetryCommand}"/>
    </StackPanel>

    <TextBlock Classes="sub" Text="Joining the network…" HorizontalAlignment="Center"
               VerticalAlignment="Center" IsVisible="{Binding IsConnecting}"/>

    <!-- ============ The list itself ============ -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding IsConnected}" IsEnabled="{Binding !IsChatting}">

      <!-- An offline account's own handle, kept on screen rather than said once when it joined.
           The four digits are not chosen and not memorable, and they are the half a friend cannot
           guess — somebody who closed the launcher and wants to be added has nowhere else to look
           for them. A Microsoft account needs none of this: its name is its name. -->
      <Border Grid.Row="0" Classes="handleBar" IsVisible="{Binding ShowsHandle}" Margin="0,0,0,10">
        <!-- The pair is centred in the bar and the button floats over the right of it, rather
             than the three sharing a row: in a row the handle takes the middle column and sits
             wherever "You are" leaves it, which is next to the label and nowhere near the middle.
             The side margins keep the centred text clear of the button it is centred under. -->
        <Panel>
          <!-- Both at one font size, which is what actually puts them on the same line. Centring
               each vertically only centres its own box, and a 12.5px box beside a 13px one is
               shorter — so the two sit at slightly different heights however they are aligned.
               The label keeps its muted colour and gives up only the half-pixel.

               Spacing of four, which is about what a space is at this size. Nine read as a gap
               between two things; this is one sentence and should read as one. -->
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="34,0"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="You are" Classes="label" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding MyHandle}" FontWeight="SemiBold" FontSize="13"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="What friends type to find you"/>
          </StackPanel>

          <Button Classes="iconGhost" Click="CopyHandle_Click"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  ToolTip.Tip="Copy your handle">
            <Viewbox Classes="icon">
              <Canvas Width="24" Height="24">
                <Path Data="M9 9 H19 V19 H9 Z M5 15 V5 H15" StrokeThickness="2"
                      StrokeLineCap="Round" StrokeJoin="Round"/>
              </Canvas>
            </Viewbox>
          </Button>
        </Panel>
      </Border>

      <!-- Add by name. Enter works because it's the only button in a one-line form. -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding NewFriendName}"
                 PlaceholderText="Minecraft username, or Name#0000">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddFriendCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="primary" Content="Add" Command="{Binding AddFriendCommand}"/>
      </Grid>

      <TextBlock Grid.Row="2" Text="{Binding Notice}" Classes="notice" TextWrapping="Wrap" Margin="2,8,2,0"
                 Classes.good="{Binding NoticeIsGood}"
                 IsVisible="{Binding Notice, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

      <!-- Empty network -->
      <StackPanel Grid.Row="3" VerticalAlignment="Center" Spacing="8" Margin="10"
                  IsVisible="{Binding IsEmpty}">
        <TextBlock Text="&#x1F338;" FontSize="34" HorizontalAlignment="Center"/>
        <TextBlock Text="No friends yet" Classes="h2" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextMuted}"/>
        <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Anyone on Asobu can be added, up there. A Microsoft account goes by its Minecraft username; an offline one by its name and tag, like Player#4963."/>
      </StackPanel>

      <ScrollViewer Grid.Row="3" ctrl:SmoothScroll.Enabled="True" Margin="0,16,0,0"
                    IsVisible="{Binding !IsEmpty}">
        <StackPanel Spacing="18">

          <!-- ===== Incoming requests ===== -->
          <StackPanel Spacing="6" IsVisible="{Binding HasIncoming}">
            <TextBlock Text="Wants to be friends" Classes="label"/>
            <ItemsControl ItemsSource="{Binding Incoming}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FriendRow">
                  <Border Classes="friendRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                      <Border Grid.Column="0" Classes="friendFace">
                        <Panel>
                          <TextBlock Text="&#x1F338;" FontSize="15" IsVisible="{Binding !HasFace}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding Face}" IsVisible="{Binding HasFace}"
                                 RenderOptions.BitmapInterpolationMode="None"/>
                        </Panel>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="2" Classes="primary" Content="Accept" Padding="14,7"
                              Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).AcceptCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Grid.Column="3" Classes="iconGhost" VerticalAlignment="Center"
                              ToolTip.Tip="Decline"
                              Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}">
                        <Viewbox Classes="icon">
                          <Path Data="M6 6 L18 18 M18 6 L6 18" StrokeThickness="2" StrokeLineCap="Round"
                                Width="24" Height="24" Stretch="None"/>
                        </Viewbox>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- ===== Friends ===== -->
          <StackPanel Spacing="6" IsVisible="{Binding HasFriends}">
            <TextBlock Text="{Binding FriendsHeading}" Classes="label"/>
            <ItemsControl ItemsSource="{Binding Friends}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FriendRow">
                  <Border Classes="friendRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Panel Grid.Column="0">
                        <Border Classes="friendFace">
                          <Panel>
                            <TextBlock Text="&#x1F338;" FontSize="15" IsVisible="{Binding !HasFace}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Face}" IsVisible="{Binding HasFace}"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                          </Panel>
                        </Border>
                        <!-- The dot rides the avatar's corner; the ring makes it read as a
                             badge rather than a stray pixel of the picture. -->
                        <Ellipse Classes="presenceDot" Classes.on="{Binding Online}"/>
                      </Panel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PresenceLabel}" Classes="label"
                                   Classes.online="{Binding Online}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                  VerticalAlignment="Center">
                        <!-- What they said while you were looking at something else. -->
                        <Border Classes="unreadBadge" IsVisible="{Binding HasUnread}">
                          <TextBlock Text="{Binding UnreadLabel}" FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource OnAccent}"/>
                        </Border>
                        <Button Classes="iconGhost" VerticalAlignment="Center" ToolTip.Tip="Message"
                                Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).OpenChatCommand}"
                                CommandParameter="{Binding}">
                          <Viewbox Classes="icon">
                            <Path Data="M4 4 H20 V15 H13 L8 20 V15 H4 Z" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="24" Height="24" Stretch="None"/>
                          </Viewbox>
                        </Button>
                        <!-- One press arms, the second means it. An icon alone gave no warning
                             and no second thought, and unfriending takes both people to undo. -->
                        <Button Classes="iconGhost" VerticalAlignment="Center" ToolTip.Tip="Remove friend"
                                IsVisible="{Binding !IsConfirmingRemove}"
                                Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).RemoveFriendCommand}"
                                CommandParameter="{Binding}">
                          <Viewbox Classes="icon">
                            <Path Data="M6 6 L18 18 M18 6 L6 18" StrokeThickness="2" StrokeLineCap="Round"
                                  Width="24" Height="24" Stretch="None"/>
                          </Viewbox>
                        </Button>
                        <Button Classes="confirmRemove" VerticalAlignment="Center" Content="Remove?"
                                IsVisible="{Binding IsConfirmingRemove}"
                                Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).RemoveFriendCommand}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- ===== Outgoing requests ===== -->
          <StackPanel Spacing="6" IsVisible="{Binding HasOutgoing}">
            <TextBlock Text="Waiting on them" Classes="label"/>
            <ItemsControl ItemsSource="{Binding Outgoing}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FriendRow">
                  <Border Classes="friendRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Border Grid.Column="0" Classes="friendFace" Opacity="0.65">
                        <Panel>
                          <TextBlock Text="&#x1F338;" FontSize="15" IsVisible="{Binding !HasFace}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding Face}" IsVisible="{Binding HasFace}"
                                 RenderOptions.BitmapInterpolationMode="None"/>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Request sent" Classes="label"/>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="iconGhost" VerticalAlignment="Center"
                              ToolTip.Tip="Cancel request"
                              Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}">
                        <Viewbox Classes="icon">
                          <Path Data="M6 6 L18 18 M18 6 L6 18" StrokeThickness="2" StrokeLineCap="Round"
                                Width="24" Height="24" Stretch="None"/>
                        </Viewbox>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </Grid>

    <!-- ============ A conversation ============ -->
    <!-- Over the list rather than beside it: the drawer is narrow, and a chat that has to share
         it with a scrolling list of everyone else is neither. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsChatting}"
          Background="{DynamicResource Bg}">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
        <Button Grid.Column="0" Classes="iconGhost" VerticalAlignment="Center"
                ToolTip.Tip="Back to friends" Command="{Binding CloseChatCommand}">
          <Viewbox Classes="icon">
            <Path Data="M16 4 L8 12 L16 20" StrokeThickness="2" StrokeLineCap="Round"
                  StrokeJoin="Round" Width="24" Height="24" Stretch="None"/>
          </Viewbox>
        </Button>

        <!-- Their face, the same one the list shows, so the conversation is obviously theirs. -->
        <Panel Grid.Column="1" VerticalAlignment="Center">
          <Border Classes="friendFace">
            <Panel>
              <TextBlock Text="&#x1F338;" FontSize="15" IsVisible="{Binding !ChatWith.HasFace}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding ChatWith.Face}" IsVisible="{Binding ChatWith.HasFace}"
                     RenderOptions.BitmapInterpolationMode="None"/>
            </Panel>
          </Border>
          <Ellipse Classes="presenceDot" Classes.on="{Binding ChatWith.Online}"/>
        </Panel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding ChatWith.Name}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding ChatWith.PresenceLabel}" Classes="label"
                     Classes.online="{Binding ChatWith.Online}"/>
        </StackPanel>

        <!-- The one check that catches a server handing out the wrong key, so it is reachable
             rather than buried — but folded away, because most people will never need it. -->
        <Button Grid.Column="3" Classes="iconGhost" VerticalAlignment="Center"
                ToolTip.Tip="Check this is really them"
                IsVisible="{Binding HasFingerprint}" Command="{Binding ToggleFingerprintCommand}">
          <Viewbox Classes="icon">
            <Path Data="M12 4 L20 7 V12 C20 16.5 16.2 19.4 12 20 C7.8 19.4 4 16.5 4 12 V7 Z"
                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="24" Height="24" Stretch="None"/>
          </Viewbox>
        </Button>
      </Grid>

      <!-- Its own row rather than sharing row 0, which had it drawn over the header — taking the
           back arrow with it, and with that any way out of the conversation. -->
      <Border Grid.Row="1" Classes="card" Margin="0,0,0,10" Padding="12,10"
              IsVisible="{Binding ShowFingerprint}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="5">
            <TextBlock Text="Is this really them?" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Classes="sub" TextWrapping="Wrap"
                       Text="Read these numbers to each other somewhere else — in game, on a call. If they match, nobody is reading your messages. If they don't, someone is."/>
            <SelectableTextBlock Text="{Binding Fingerprint}" FontFamily="Consolas, Menlo, monospace"
                                 FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Accent}"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="iconGhost" VerticalAlignment="Top" ToolTip.Tip="Close"
                  Command="{Binding ToggleFingerprintCommand}">
            <Viewbox Classes="icon">
              <Path Data="M6 6 L18 18 M18 6 L6 18" StrokeThickness="2" StrokeLineCap="Round"
                    Width="24" Height="24" Stretch="None"/>
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="2" Name="ChatScroll" ctrl:SmoothScroll.Enabled="True"
                    AllowAutoHide="False">
        <StackPanel Spacing="6">

          <!-- Said once, in the empty conversation, because it is the one thing about this that
               would surprise somebody: closing Asobu is the end of it. -->
          <StackPanel Spacing="6" Margin="0,20,0,0" IsVisible="{Binding ConversationIsEmpty}">
            <TextBlock Text="&#x1F4AC;" FontSize="26" HorizontalAlignment="Center"/>
            <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Nothing here yet. Messages are encrypted on your machine and opened on theirs — our server relays them without being able to read them, and stores none of them. The conversation lasts as long as Asobu stays open."/>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Conversation}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FriendsViewModel+ChatLine">
                <Grid>
                  <Border Classes="bubble theirs" IsVisible="{Binding Theirs}">
                    <StackPanel Spacing="2">
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           IsVisible="{Binding IsText}"/>
                      <!-- Corner-clipped so the picture takes the bubble's shape rather than
                           squaring off inside it. -->
                      <Border Classes="bubblePicture" IsVisible="{Binding IsPicture}">
                        <Image Source="{Binding Picture}" Stretch="Uniform"/>
                      </Border>
                      <TextBlock Text="{Binding TimeLabel}" Classes="label" FontSize="10"
                                 HorizontalAlignment="Right"/>
                    </StackPanel>
                  </Border>
                  <Border Classes="bubble mine" IsVisible="{Binding Mine}">
                    <StackPanel Spacing="2">
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           IsVisible="{Binding IsText}"
                                           Foreground="{DynamicResource OnAccent}"/>
                      <Border Classes="bubblePicture" IsVisible="{Binding IsPicture}">
                        <Image Source="{Binding Picture}" Stretch="Uniform"/>
                      </Border>
                      <TextBlock Text="{Binding TimeLabel}" FontSize="10"
                                 Opacity="0.7" HorizontalAlignment="Right"
                                 Foreground="{DynamicResource OnAccent}"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="3" Spacing="6" Margin="0,10,0,0">
        <TextBlock Text="{Binding ChatError}" Classes="label" TextWrapping="Wrap"
                   Foreground="{DynamicResource LogError}" IsVisible="{Binding HasChatError}"/>

        <!-- Said before anything is typed rather than after it fails to send. -->
        <TextBlock Classes="label" Text="Shrinking the picture&#x2026;"
                   IsVisible="{Binding IsSendingPicture}"/>

        <TextBlock Classes="label" TextWrapping="Wrap" IsVisible="{Binding !CanReachThem}"
                   Text="They're on an older Asobu with no encryption key yet. Once they update, you can message them."/>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <Button Grid.Column="0" Classes="iconGhost" VerticalAlignment="Center"
                  ToolTip.Tip="Send a picture" IsEnabled="{Binding !IsSendingPicture}"
                  Command="{Binding SendPictureCommand}">
            <Viewbox Classes="icon">
              <Path Data="M4 5 H20 V19 H4 Z M4 15 L9 10 L13 14 L16 11 L20 15"
                    StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="24" Height="24" Stretch="None"/>
            </Viewbox>
          </Button>

          <!-- Enter sends, the same way it adds a friend one panel over. -->
          <TextBox Grid.Column="1" Text="{Binding Draft}" PlaceholderText="Say something"
                   MaxLength="2000" AcceptsReturn="False">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SendChatCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="2" Classes="primary" Content="Send" Padding="14,7"
                  IsEnabled="{Binding CanSend}" Command="{Binding SendChatCommand}"/>
        </Grid>
      </StackPanel>

    </Grid>

  </Panel>
</UserControl>

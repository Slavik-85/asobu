<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:Asobu.App.Controls"
             xmlns:vm="using:Asobu.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Asobu.App.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">

  <!-- The inside of the friends drawer. The header and close button belong to the drawer
       itself, over in MainWindow; this is everything under them. -->
  <Panel Margin="22,6,22,18">

    <!-- ============ No Microsoft account ============ -->
    <StackPanel VerticalAlignment="Center" Spacing="10" IsVisible="{Binding NeedsMicrosoft}">
      <TextBlock Text="&#x1F338;" FontSize="34" HorizontalAlignment="Center"/>
      <TextBlock Text="Friends needs a Microsoft account" Classes="h2" HorizontalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{DynamicResource TextMuted}"/>
      <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap"
                 Text="Your Minecraft identity is your identity here — no extra account, nothing else to make. Sign in and you're on the network."/>
      <Button Classes="primary" Content="Go to Accounts" HorizontalAlignment="Center" Margin="0,8,0,0"
              Command="{Binding GoAccountsCommand}"/>
    </StackPanel>

    <!-- ============ Connection trouble ============ -->
    <!-- ConnectionError is only ever set by a connection attempt and cleared on account change,
         so its presence alone decides this state. -->
    <StackPanel VerticalAlignment="Center" Spacing="10"
                IsVisible="{Binding ConnectionError, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <TextBlock Text="&#x1F327;" FontSize="34" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding ConnectionError}" Classes="sub" TextAlignment="Center" TextWrapping="Wrap"/>
      <Button Classes="ghost" Content="Try again" HorizontalAlignment="Center" Margin="0,8,0,0"
              Command="{Binding RetryCommand}"/>
    </StackPanel>

    <TextBlock Classes="sub" Text="Joining the network…" HorizontalAlignment="Center"
               VerticalAlignment="Center" IsVisible="{Binding IsConnecting}"/>

    <!-- ============ The list itself ============ -->
    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsConnected}" IsEnabled="{Binding !IsChatting}">

      <!-- Add by name. Enter works because it's the only button in a one-line form. -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding NewFriendName}"
                 PlaceholderText="Minecraft username">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AddFriendCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Classes="primary" Content="Add" Command="{Binding AddFriendCommand}"/>
      </Grid>

      <TextBlock Grid.Row="1" Text="{Binding Notice}" Classes="notice" TextWrapping="Wrap" Margin="2,8,2,0"
                 Classes.good="{Binding NoticeIsGood}"
                 IsVisible="{Binding Notice, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

      <!-- Empty network -->
      <StackPanel Grid.Row="2" VerticalAlignment="Center" Spacing="8" Margin="10"
                  IsVisible="{Binding IsEmpty}">
        <TextBlock Text="&#x1F338;" FontSize="34" HorizontalAlignment="Center"/>
        <TextBlock Text="No friends yet" Classes="h2" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextMuted}"/>
        <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Anyone who has signed in to Asobu with Microsoft can be added — just their Minecraft username, up there."/>
      </StackPanel>

      <ScrollViewer Grid.Row="2" ctrl:SmoothScroll.Enabled="True" Margin="0,16,0,0"
                    IsVisible="{Binding !IsEmpty}">
        <StackPanel Spacing="18">

          <!-- ===== Incoming requests ===== -->
          <StackPanel Spacing="6" IsVisible="{Binding HasIncoming}">
            <TextBlock Text="Wants to be friends" Classes="label"/>
            <ItemsControl ItemsSource="{Binding Incoming}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FriendRow">
                  <Border Classes="friendRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                      <Border Grid.Column="0" Classes="friendFace">
                        <Panel>
                          <TextBlock Text="&#x1F338;" FontSize="15" IsVisible="{Binding !HasFace}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding Face}" IsVisible="{Binding HasFace}"
                                 RenderOptions.BitmapInterpolationMode="None"/>
                        </Panel>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="2" Classes="primary" Content="Accept" Padding="14,7"
                              Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).AcceptCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Grid.Column="3" Classes="iconGhost" ToolTip.Tip="Decline"
                              Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="M6 6 L18 18 M18 6 L6 18" StrokeThickness="2" StrokeLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- ===== Friends ===== -->
          <StackPanel Spacing="6" IsVisible="{Binding HasFriends}">
            <TextBlock Text="{Binding FriendsHeading}" Classes="label"/>
            <ItemsControl ItemsSource="{Binding Friends}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FriendRow">
                  <Border Classes="friendRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Panel Grid.Column="0">
                        <Border Classes="friendFace">
                          <Panel>
                            <TextBlock Text="&#x1F338;" FontSize="15" IsVisible="{Binding !HasFace}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Face}" IsVisible="{Binding HasFace}"
                                   RenderOptions.BitmapInterpolationMode="None"/>
                          </Panel>
                        </Border>
                        <!-- The dot rides the avatar's corner; the ring makes it read as a
                             badge rather than a stray pixel of the picture. -->
                        <Ellipse Classes="presenceDot" Classes.on="{Binding Online}"/>
                      </Panel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PresenceLabel}" Classes="label"
                                   Classes.online="{Binding Online}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                  VerticalAlignment="Center">
                        <!-- What they said while you were looking at something else. -->
                        <Border Classes="unreadBadge" IsVisible="{Binding HasUnread}">
                          <TextBlock Text="{Binding UnreadLabel}" FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource OnAccent}"/>
                        </Border>
                        <Button Classes="iconGhost" ToolTip.Tip="Message"
                                Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).OpenChatCommand}"
                                CommandParameter="{Binding}">
                          <Path Data="M4 5 H20 V16 H12 L7 20 V16 H4 Z" StrokeThickness="1.8"
                                StrokeLineCap="Round" StrokeJoin="Round"
                                Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Classes="iconGhost" ToolTip.Tip="Remove friend"
                                Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}">
                          <Path Data="M6 6 L18 18 M18 6 L6 18" StrokeThickness="2" StrokeLineCap="Round"
                                Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- ===== Outgoing requests ===== -->
          <StackPanel Spacing="6" IsVisible="{Binding HasOutgoing}">
            <TextBlock Text="Waiting on them" Classes="label"/>
            <ItemsControl ItemsSource="{Binding Outgoing}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FriendRow">
                  <Border Classes="friendRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Border Grid.Column="0" Classes="friendFace" Opacity="0.65">
                        <Panel>
                          <TextBlock Text="&#x1F338;" FontSize="15" IsVisible="{Binding !HasFace}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding Face}" IsVisible="{Binding HasFace}"
                                 RenderOptions.BitmapInterpolationMode="None"/>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Request sent" Classes="label"/>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="iconGhost" ToolTip.Tip="Cancel request"
                              Command="{Binding $parent[ItemsControl].((vm:FriendsViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="M6 6 L18 18 M18 6 L6 18" StrokeThickness="2" StrokeLineCap="Round"
                              Width="12" Height="12" Stretch="Uniform"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </Grid>

    <!-- ============ A conversation ============ -->
    <!-- Over the list rather than beside it: the drawer is narrow, and a chat that has to share
         it with a scrolling list of everyone else is neither. -->
    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsChatting}"
          Background="{DynamicResource Bg}">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
        <Button Grid.Column="0" Classes="iconGhost" ToolTip.Tip="Back to friends"
                Command="{Binding CloseChatCommand}">
          <Path Data="M15 5 L8 12 L15 19" StrokeThickness="2" StrokeLineCap="Round"
                StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform"/>
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding ChatWith.Name}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding ChatWith.PresenceLabel}" Classes="label"
                     Classes.online="{Binding ChatWith.Online}"/>
        </StackPanel>

        <!-- The one check that catches a server handing out the wrong key, so it is reachable
             rather than buried — but folded away, because most people will never need it. -->
        <Button Grid.Column="2" Classes="iconGhost" ToolTip.Tip="Check this is really them"
                IsVisible="{Binding HasFingerprint}" Command="{Binding ToggleFingerprintCommand}">
          <Path Data="M12 3 L19 6 V12 C19 16 15 19.5 12 21 C9 19.5 5 16 5 12 V6 Z"
                StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                Width="14" Height="14" Stretch="Uniform"/>
        </Button>
      </Grid>

      <Border Grid.Row="0" Classes="card" Margin="0,44,0,10" Padding="12,10"
              VerticalAlignment="Top" IsVisible="{Binding ShowFingerprint}">
        <StackPanel Spacing="5">
          <TextBlock Text="Is this really them?" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Classes="sub" TextWrapping="Wrap"
                     Text="Read these numbers to each other somewhere else — in game, on a call. If they match, nobody is reading your messages. If they don't, someone is."/>
          <SelectableTextBlock Text="{Binding Fingerprint}" FontFamily="Consolas, Menlo, monospace"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource Accent}"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Name="ChatScroll" ctrl:SmoothScroll.Enabled="True"
                    AllowAutoHide="False">
        <StackPanel Spacing="6">

          <!-- Said once, in the empty conversation, because it is the one thing about this that
               would surprise somebody: closing Asobu is the end of it. -->
          <StackPanel Spacing="6" Margin="0,20,0,0" IsVisible="{Binding ConversationIsEmpty}">
            <TextBlock Text="&#x1F4AC;" FontSize="26" HorizontalAlignment="Center"/>
            <TextBlock Classes="sub" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Nothing here yet. Messages are encrypted on your machine and opened on theirs — our server relays them without being able to read them, and stores none of them. The conversation lasts as long as Asobu stays open."/>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Conversation}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FriendsViewModel+ChatLine">
                <Grid>
                  <Border Classes="bubble theirs" IsVisible="{Binding Theirs}">
                    <StackPanel Spacing="2">
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding TimeLabel}" Classes="label" FontSize="10"
                                 HorizontalAlignment="Right"/>
                    </StackPanel>
                  </Border>
                  <Border Classes="bubble mine" IsVisible="{Binding Mine}">
                    <StackPanel Spacing="2">
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource OnAccent}"/>
                      <TextBlock Text="{Binding TimeLabel}" FontSize="10"
                                 Opacity="0.7" HorizontalAlignment="Right"
                                 Foreground="{DynamicResource OnAccent}"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
        <TextBlock Text="{Binding ChatError}" Classes="label" TextWrapping="Wrap"
                   Foreground="{DynamicResource LogError}" IsVisible="{Binding HasChatError}"/>

        <!-- Said before anything is typed rather than after it fails to send. -->
        <TextBlock Classes="label" TextWrapping="Wrap" IsVisible="{Binding !CanReachThem}"
                   Text="They're on an older Asobu with no encryption key yet. Once they update, you can message them."/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <!-- Enter sends, the same way it adds a friend one panel over. -->
          <TextBox Grid.Column="0" Text="{Binding Draft}" PlaceholderText="Say something"
                   MaxLength="2000" AcceptsReturn="False">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SendChatCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Classes="primary" Content="Send" Padding="14,7"
                  IsEnabled="{Binding CanSend}" Command="{Binding SendChatCommand}"/>
        </Grid>
      </StackPanel>

    </Grid>

  </Panel>
</UserControl>

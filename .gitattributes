# Line endings, decided here rather than by whichever machine last touched a file.
#
# This matters beyond tidiness: the systemd unit and the Go server are read by Linux, and a
# stray carriage return at the end of an ExecStart line becomes part of the path, so the
# service fails to start with an error that names a binary that looks exactly right.

* text=auto

# Anything Linux reads keeps LF, whatever platform it was edited on.
*.sh      text eol=lf
*.go      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.service text eol=lf

# And anything only Windows runs keeps CRLF.
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary, so git neither diffs nor mangles them.
*.png     binary
*.ico     binary
*.webp    binary
*.jar     binary
